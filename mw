ROLE_NODE = Qt.UserRole
ROLE_STORE_ID = Qt.UserRole + 1
ROLE_FOLDER_ID = Qt.UserRole + 2


# ============================================================
# Scan Worker
# ============================================================

class ScanWorker(QObject):
    finished = Signal(object)
    failed = Signal(str)
    cancelled = Signal()
    progress = Signal(object)

    def __init__(self):
        super().__init__()

        self._cancel_requested = False

    def cancel(self):
        self._cancel_requested = True

    def _is_cancelled(self):
        return self._cancel_requested

    def run(self):
        try:
            scanner = OutlookScanner(
                cancel_callback=self._is_cancelled,
                progress_callback=self.progress.emit,
            )

            stores = scanner.scan()

            if self._cancel_requested:
                self.cancelled.emit()
                return

            self.finished.emit(stores)

        except ScanCancelled:
            self.cancelled.emit()

        except Exception as exc:
            log_exception(
                "Outlook folder scan failed"
            )

            self.failed.emit(
                str(exc)
            )


# ============================================================
# Full Build Worker
# ============================================================

class FullBuildWorker(QObject):
    finished = Signal(object)
    failed = Signal(str)
    cancelled = Signal()
    progress = Signal(object)

    def __init__(
        self,
        db_manager,
        folders,
    ):
        super().__init__()

        self.db_manager = db_manager
        self.folders = folders

        self._cancel_requested = False

    def cancel(self):
        self._cancel_requested = True

    def _is_cancelled(self):
        return self._cancel_requested

    def run(self):
        try:
            builder = MailBuilder(
                db_manager=self.db_manager,
                folders=self.folders,
                cancel_callback=self._is_cancelled,
                progress_callback=self.progress.emit,
            )

            result = builder.build()

            if self._cancel_requested:
                self.cancelled.emit()
                return

            self.finished.emit(result)

        except BuildCancelled:
            self.cancelled.emit()

        except Exception as exc:
            log_exception(
                "Full build worker failed"
            )

            self.failed.emit(
                str(exc)
            )


